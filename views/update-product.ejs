* Version: 2.1
* Author: Alexis Luna
* Website: https://github.com/alexis-luna/bootstrap-simple-admin-template
-->
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Update Product</title>
    <link href="../../../public/assets/vendor/fontawesome/css/fontawesome.min.css" rel="stylesheet">
    <link href="../../../public/assets/vendor/fontawesome/css/solid.min.css" rel="stylesheet">
    <link href="../../../public/assets/vendor/fontawesome/css/brands.min.css" rel="stylesheet">
    <link href="../../../public/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="../../../public/assets/css/master.css" rel="stylesheet">
    <link href="../../../public/assets/vendor/airdatepicker/css/datepicker.min.css" rel="stylesheet">
    <link href="../../../public/assets/vendor/mdtimepicker/mdtimepicker.min.css" rel="stylesheet">
</head>
<style>
    .co{
        background-color: #f0f0f0;
    }
</style>
<body>
    <div class="wrapper">
        <%- include('./layouts/nav-1.ejs') -%>
        <div id="body" class="active">
            <%- include('./layouts/nav-2.ejs') -%>
            <div class="content">
                <div class="container-fluid">
                    <div class="page-title">
                        <div class="container">
                            <h3>Update Product</h3>
                            <% if (message) { %>
                                <div class="alert alert-success">
                                    <h4 class="alert-title"><i class="fas fa-check"></i> Success</h4>
                                    <%= message %>
                                </div>
                            <% } %>
                            <% if (Array.isArray(error_message)) { %>
                                <ul>
                                    <div class="alert alert-danger" >
                                        <h5 class="alert-title"><i class="fas fa-exclamation-triangle"></i> Error!</h5>
                                        <% error_message.forEach(err => { %>
                                            <li style="margin-left: 30px;"><%= err %></li>
                                        <% }); %>
                                    </div>
                                </ul>
                            <% } else if (error_message) { %>
                                <div class="alert alert-danger">
                                    <h5 class="alert-title"><i class="fas fa-exclamation-triangle"></i> Error!</h5>
                                    <%= error_message %>
                                </div>
                            <% } %>
                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-header">Product Data</div>
                                    <div class="card-body" >
                                        <!-- style="background-color: #f0f0f0;" -->
                                        <form id="upForm" class="needs-validation" novalidate accept-charset="utf-8" method="post" enctype="multipart/form-data">
                                            <!-- enctype="multipart/form-data"> -->
                                            <div class="row g-2">
                                                <div style="width: 100%; text-align: center;" class="mb-3 col-md-6">
                                                    <label class="form-label"><h3>Product Images</h3><p>(Select up to 5 images!)</p></label>
                                                    <div id="imagesPreview" class="imagesPreview" style="display: flex; justify-content: space-evenly; flex-direction: column; flex-wrap: wrap;">
                                                        <div style="display: flex; justify-content: space-evenly; flex-direction: row; flex-wrap: wrap;">
                                                            <% for( let index = 0; index < 5; index++ ) { %>
                                                                <% if (product.ProductImages[index]) { %>
                                                                    <img id="<%= `pimg${index+1}` %>" src="http://localhost:5000/images/<%= product.ProductImages[index].name %>" onerror="this.src='../../../public/assets/img/default_product.png'" class="rounded" width="150px" style="object-fit: cover;">                                                         
                                                                <% } else { %>
                                                                    <img id="<%= `pimg${index+1}` %>" src="../../../public/assets/img/default_product.png" onerror="this.src='../../../public/assets/img/default_product.png'" class="rounded" width="150px" style="object-fit: cover;">
                                                                <% }%>
                                                            <% } %>
                                                        </div>
                                                        <br>
                                                        <input type="file" id="fileInput" name="images" multiple accept="image/*" class="form-control co">
                                                    </div>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                <label for="name" class="form-label">Name</label>
                                                <input type="text" class="form-control co"  name="name" value="<%= product.name %>" autocomplete="off" required>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                    <label for="category" class="form-label">Category</label>
                                                    <select name="category_id" class="form-select co" required>
                                                            <option value="" selected disabled hidden>Category</option>
                                                            <% categories.forEach(category => { %>
                                                                <option value="<%= category.id %>" <% if (product.category_id == category.id) { %> selected<% } %>><%= category.name %></option>
                                                            <% }); %>
                                                    </select>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                    <label for="supplier" class="form-label">Supplier</label>
                                                    <select name="supplier_id" class="form-select co" required>
                                                            <option value="" selected disabled hidden>Supplier</option>
                                                            <% suppliers.forEach(supplier => { %>
                                                                <option value="<%= supplier.id %>" <% if (product.supplier_id == supplier.id) { %> selected<% } %>><%= supplier.name %></option>
                                                            <% }); %>
                                                    </select>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                <label for="price" class="form-label">Price</label>
                                                <input type="number" class="form-control co" name="price" value="<%= product.price %>" placeholder="Price" autocomplete="off" step="0.01" required>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                <label for="quantity" class="form-label">Quantity</label>
                                                <input type="number" class="form-control co" name="quantity" value="<%= product.quantity %>" placeholder="Quantity" autocomplete="off" required>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                    <label for="description" class="form-label">Description/Bio</label>
                                                    <textarea type="text" class="form-control co" name="description" cols="30" rows="3" autocomplete="off"><%= product.description %></textarea>
                                                </div>
                                            </div>
                                            <div style="width: 100%; text-align: center;">
                                                <input class="btn btn-primary" type="submit" value="Update Product">
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('./layouts/danger-alert-modal.ejs') %>
    <script src="../../../public/assets/vendor/jquery/jquery.min.js"></script>
    <script src="../../../public/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="../../../public/assets/js/form-validator.js"></script>
    <!-- maybe remove the validator in the line above -->
    <script src="../../../public/assets/vendor/jquery/jquery.min.js"></script>
    <script src="../../../public/assets/js/script.js"></script>
    <script>
        let removedImages = [];
        let inputFile = document.getElementById('fileInput');
        inputFile.onchange = (event) => {
            let selectedFiles = event.target.files;
            if (selectedFiles.length > 5){
                let modal = new bootstrap.Modal(document.getElementById("dangerAlertModal"), {});
                modal.show();
                document.getElementById('ok').onclick = () => {
                    inputFile.type = '';
                    inputFile.type = 'file';
                    modal.hide();
                }; 
            }
            else if (selectedFiles.length > 0) {
                for (const key in selectedFiles) {
                    if(key != 'length' && key != 'item') {
                        const file = selectedFiles[key];
                        imageId = `pimg${5-key}`;
                        mImg = document.getElementById(imageId);
                        if(mImg.src.includes('productImage')) removedImages.push(mImg.src);
                        mImg.src = URL.createObjectURL(file);
                    }
                }
                let input = document.createElement("input");
                input.setAttribute("type", "hidden");
                input.setAttribute("name", "removedImages");
                input.setAttribute("value", removedImages);
                
                document.getElementById('upForm').appendChild(input);
            }
        };
    </script>
</body>

</html>