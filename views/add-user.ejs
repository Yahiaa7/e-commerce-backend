
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Add User</title>
    <link href="../../public/assets/vendor/fontawesome/css/fontawesome.min.css" rel="stylesheet">
    <link href="../../public/assets/vendor/fontawesome/css/solid.min.css" rel="stylesheet">
    <link href="../../public/assets/vendor/fontawesome/css/brands.min.css" rel="stylesheet">
    <link href="../../public/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="../../public/assets/css/master.css" rel="stylesheet">
    <link href="../../public/assets/vendor/airdatepicker/css/datepicker.min.css" rel="stylesheet">
    <link href="../../public/assets/vendor/mdtimepicker/mdtimepicker.min.css" rel="stylesheet">
</head>
<style>
    .co{
        background-color: #f0f0f0;
    }
</style>
<body>
    <div class="wrapper">
        <%- include('./layouts/nav-1.ejs') -%>
        <div id="body" class="active">
            <%- include('./layouts/nav-2.ejs') -%>
            <div class="content">
                <div class="container-fluid">
                    <div class="page-title">
                        <div class="container">
                            <h3>Add User</h3>
                            <% if (message) { %>
                                <div class="alert alert-success">
                                    <h4 class="alert-title"><i class="fas fa-check"></i> Success</h4>
                                    <%= message %>
                                </div>
                            <% } %>
                            <% if (error_message) { %>
                                <div class="alert alert-danger">
                                    <h5 class="alert-title"><i class="fas fa-exclamation-triangle"></i> Error!</h5>
                                    <%= error_message %>
                                </div>
                            <% } %>
                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-header">User Data</div>
                                    <div class="card-body" >
                                        <!-- style="background-color: #f0f0f0;" -->
                                        <form class="needs-validation" novalidate accept-charset="utf-8" method="post" enctype="multipart/form-data">
                                            <div class="row g-2">
                                                <div style="width: 100%; text-align: center;" class="mb-3 col-md-6">
                                                    <img id="imagePreview" src="../../public/assets/img/default_pp.jpg" onerror="this.src='../../public/assets/img/default_pp.jpg'" alt="user picture"  width="150px" height="150px" style=" object-fit: cover; aspect-ratio: 3/4; border-radius: 50%; overflow: hidden; cursor: pointer;" >
                                                    <input type="file" id="fileInput" name="image" style="display: none;">
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                <label for="name" class="form-label">Name</label>
                                                <input type="text" class="form-control co"  name="name" placeholder="Name" autocomplete="off" required>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                <label for="gender" class="form-label">Gender</label>
                                                <select name="gender" class="form-select co" required>
                                                        <option value="" selected disabled hidden>Gender</option>
                                                        <option value="Male">Male</option>
                                                        <option value="Female">Female</option>
                                                </select>
                                                </div>
                                            </div>
                                            <div class="row g-2">
                                                <div class="mb-3 col-md-6">
                                                <label for="username" class="form-label">Username</label>
                                                <input type="text" class="form-control co" name="username" placeholder="Username" autocomplete="off" required>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                <label for="password" class="form-label">Password</label>
                                                <input type="text" class="form-control co" name="password" placeholder="Password" autocomplete="off" required>
                                                <!-- type="password" -->
                                            </div>
                                            </div>
                                            <div class="row g-2">
                                                <div class="mb-3 col-md-6">
                                                <label for="email_address" class="form-label">Email</label>
                                                <input type="email" class="form-control co" name="email_address" placeholder="Email Address" autocomplete="off">
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                <label for="phone" class="form-label">Phone Number</label>
                                                <input type="number" class="form-control co" name="phone" placeholder="Phone number" autocomplete="off">
                                                </div>
                                            </div>
                                            <div class="row g-2">
                                                <div class="mb-3 col-md-6">
                                                    <label for="birthday" class="form-label">Birthday</label>
                                                    <input type="text"  name="birthday" class="form-control co datepicker-here" data-language="en" autocomplete="off" aria-describedby="datepicker" placeholder="Birthday">
                                                    <!-- <input type="date" class="form-control co" name="birthday" placeholder="Birthday"> -->
                                                </div>
                                                <div class="mb-3 col-md-3">
                                                    <label for="role" class="form-label">Role</label>
                                                    <select name="role" class="form-select co" required>
                                                        <option value="" selected disabled hidden>Role</option>
                                                        <option value="Admin">Admin</option>
                                                        <option value="Store Manager">Store Manager</option>
                                                        <option value="Advertising Manager">Advertising Manager</option>
                                                        <option value="User">User</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3 col-md-3">
                                                    <label for="status" class="form-label">Status</label>
                                                    <select name="status" class="form-select co" required>
                                                        <option value="" selected disabled hidden>Status</option>
                                                        <option value="Active">Active</option>
                                                        <option value="Pending">Pending</option>
                                                        <option value="Inactive">Inactive</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label for="description" class="form-label">Description/Bio</label>
                                                <textarea type="text" class="form-control co" name="description" placeholder="Bio .." cols="30" rows="3" autocomplete="off"></textarea>
                                            </div>
                                            <div style="width: 100%; text-align: center;">
                                                <input class="btn btn-primary" type="submit" value="Add User">
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="../../public/assets/vendor/jquery/jquery.min.js"></script>
    <script src="../../public/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="../../public/assets/js/form-validator.js"></script>
    <!-- maybe remove the validator in the line above -->
    <script src="../../public/assets/vendor/jquery/jquery.min.js"></script>
    <script src="../../public/assets/vendor/airdatepicker/js/datepicker.min.js"></script>
    <script src="../../public/assets/vendor/airdatepicker/js/i18n/datepicker.en.js"></script>
    <script src="../../public/assets/js/script.js"></script>
    <script>
        const imagePreview = document.getElementById('imagePreview');
        const fileInput = document.getElementById('fileInput');

        imagePreview.onclick = () => fileInput.click();
        fileInput.onchange = (event) => {
            const selectedFile = event.target.files[0];
            if (selectedFile) {
                let reader = new FileReader();
                reader.onload = (event) => imagePreview.setAttribute('src', event.target.result);
                reader.readAsDataURL(selectedFile);
            }
        };
    </script>
</body>

</html>