
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Add Product</title>
    <link href="../../public/assets/vendor/fontawesome/css/fontawesome.min.css" rel="stylesheet">
    <link href="../../public/assets/vendor/fontawesome/css/solid.min.css" rel="stylesheet">
    <link href="../../public/assets/vendor/fontawesome/css/brands.min.css" rel="stylesheet">
    <link href="../../public/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="../../public/assets/css/master.css" rel="stylesheet">
    <link href="../../public/assets/vendor/airdatepicker/css/datepicker.min.css" rel="stylesheet">
    <link href="../../public/assets/vendor/mdtimepicker/mdtimepicker.min.css" rel="stylesheet">
</head>
<style>
    .co{
        background-color: #f0f0f0;
    }
</style>
<body>
    <div class="wrapper">
        <%- include('./layouts/nav-1.ejs') -%>
        <div id="body" class="active">
            <%- include('./layouts/nav-2.ejs') -%>
            <div class="content">
                <div class="container-fluid">
                    <div class="page-title">
                        <div class="container">
                            <h3>Add Product</h3>
                            <% if (message) { %>
                                <div class="alert alert-success">
                                    <h4 class="alert-title"><i class="fas fa-check"></i> Success</h4>
                                    <%= message %>
                                </div>
                            <% } %>
                            <% if (Array.isArray(error_message)) { %>
                                <ul>
                                    <div class="alert alert-danger" >
                                        <h5 class="alert-title"><i class="fas fa-exclamation-triangle"></i> Error!</h5>
                                        <% error_message.forEach(err => { %>
                                            <li style="margin-left: 30px;"><%= err %></li>
                                        <% }); %>
                                    </div>
                                </ul>
                            <% } else if (error_message) { %>
                                <div class="alert alert-danger">
                                    <h5 class="alert-title"><i class="fas fa-exclamation-triangle"></i> Error!</h5>
                                    <%= error_message %>
                                </div>
                            <% } %>
                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-header">Product Info</div>
                                    <div class="card-body" >
                                        <!-- style="background-color: #f0f0f0;" -->
                                        <form class="needs-validation" novalidate accept-charset="utf-8" method="post" enctype="multipart/form-data">
                                            <div class="row g-2">
                                                <div style="width: 100%; text-align: center;" class="mb-3 col-md-6">
                                                    <!-- <img id="imagePreview" src="../../public/assets/img/default_pp.jpg" onerror="this.src='../../public/assets/img/default_pp.jpg'" alt="user picture"  width="150px" height="150px" style=" object-fit: cover; aspect-ratio: 3/4; border-radius: 50%; overflow: hidden; cursor: pointer;" > -->
                                                    <label class="form-label"><h3>Product Images</h3><p>(Select up to 5 images!)</p></label>
                                                    <div id="imagesPreview" class="imagesPreview" style="display: flex; justify-content: space-evenly;">
                                                        <img id="pimg1" src="../../public/assets/img/default_product.png" onerror="this.src='../../public/assets/img/default_product.png'" alt="product picture 1" class="rounded" width="150px" style="object-fit: cover;">
                                                        <img id="pimg2" src="../../public/assets/img/default_product.png" onerror="this.src='../../public/assets/img/default_product.png'" alt="product picture 2" class="rounded" width="150px" style="object-fit: cover;">
                                                        <img id="pimg3" src="../../public/assets/img/default_product.png" onerror="this.src='../../public/assets/img/default_product.png'" alt="product picture 3" class="rounded" width="150px" style="object-fit: cover;">
                                                        <img id="pimg4" src="../../public/assets/img/default_product.png" onerror="this.src='../../public/assets/img/default_product.png'" alt="product picture 4" class="rounded" width="150px" style="object-fit: cover;">
                                                        <img id="pimg5" src="../../public/assets/img/default_product.png" onerror="this.src='../../public/assets/img/default_product.png'" alt="product picture 5" class="rounded" width="150px" style="object-fit: cover;">
                                                    </div>
                                                    <br>
                                                    <input type="file" id="fileInput" name="images" multiple accept="image/*" class="form-control co">
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                <label for="name" class="form-label">Name</label>
                                                <input type="text" class="form-control co"  name="name" placeholder="Name" autocomplete="off" required>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                    <label for="category" class="form-label">Category</label>
                                                    <select name="category_id" class="form-select co" required>
                                                            <option value="" selected disabled hidden>Category</option>
                                                            <% categories.forEach(category => { %>
                                                                <option value="<%= category.id %>"><%= category.name %></option>
                                                            <% }); %>
                                                    </select>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                    <label for="supplier" class="form-label">Supplier</label>
                                                    <select name="supplier_id" class="form-select co" required>
                                                            <option value="" selected disabled hidden>Supplier</option>
                                                            <% suppliers.forEach(supplier => { %>
                                                                <option value="<%= supplier.id %>"><%= supplier.name %></option>
                                                            <% }); %>
                                                    </select>
                                                </div>
                                            
                                                <div class="mb-3 col-md-6">
                                                <label for="price" class="form-label">Price</label>
                                                <input type="number" class="form-control co" name="price" placeholder="Price" autocomplete="off" step="0.01" required>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                <label for="quantity" class="form-label">Quantity</label>
                                                <input type="number" class="form-control co" name="quantity" placeholder="Quantity" autocomplete="off" required>
                                                </div>
                                                <div class="mb-3 col-md-6">
                                                    <label for="description" class="form-label">Description</label>
                                                    <textarea type="text" class="form-control co" name="description" placeholder="Bio .." cols="30" rows="3" autocomplete="off"></textarea>
                                                </div>
                                            </div>
                                            <div style="width: 100%; text-align: center;">
                                                <input class="btn btn-primary" type="submit" value="Add Product">
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('./layouts/danger-alert-modal.ejs') %>
    <script src="../../public/assets/vendor/jquery/jquery.min.js"></script>
    <script src="../../public/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="../../public/assets/js/form-validator.js"></script>
    <!-- maybe remove the validator in the line above -->
    <script src="../../public/assets/vendor/jquery/jquery.min.js"></script>
    <script src="../../public/assets/vendor/airdatepicker/js/datepicker.min.js"></script>
    <script src="../../public/assets/vendor/airdatepicker/js/i18n/datepicker.en.js"></script>
    <script src="../../public/assets/js/script.js"></script>
    <script>
        let inputFile = document.getElementById('fileInput');
        inputFile.onchange = (event) => {
            let selectedFiles = event.target.files;
            if (selectedFiles.length > 5){
                let modal = new bootstrap.Modal(document.getElementById("dangerAlertModal"), {});
                modal.show();
                document.getElementById('ok').onclick = () => {
                    inputFile.type = '';
                    inputFile.type = 'file';
                    modal.hide();
                }; 
            }
            else if (selectedFiles.length > 0) {
                for (let i = 0; i < selectedFiles.length; i++) {
                    imageId = `pimg${i+1}`;
                    mImg = document.getElementById(imageId);
                    mImg.src = URL.createObjectURL(selectedFiles[i]);
                }
            }
        };
    </script>
</body>

</html>