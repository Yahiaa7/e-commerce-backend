
    <title>Users</title>
    <link href="/assets/vendor/fontawesome/css/fontawesome.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome/css/solid.min.css" rel="stylesheet">
    <link href="/assets/vendor/fontawesome/css/brands.min.css" rel="stylesheet">
    <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/vendor/datatables/datatables.min.css" rel="stylesheet">
    <link href="/assets/css/master.css" rel="stylesheet">

    <%- include('./layouts/confirmation-modal.ejs') -%>
    <div id="body" class="active">
        <div class="content">
            <div class="container">
                <div class="page-title">
                    <h3>Users
                        <a href="/dashboard/addUser" class="btn btn-sm btn-outline-primary float-end"><i class="fas fa-user-plus"></i>  Add User</a>
                    </h3>
                </div>
                <div class="box box-primary">
                    <div class="box-body">
                        <table width="100%" class="table table-hover" id="dataTables-example">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Username</th>
                                    <th>Email Address</th>
                                    <th>Gender</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach((user, index) => { %>
                                    <tr>
                                        <td><%= user.name %></td>
                                        <td><%= user.username %></td>
                                        <td><%= user.email_address %></td>
                                        <td><%= user.gender %></td>
                                        <td><%= user.role %></td>
                                        <td>
                                            <div class="mb-3 col-md-6">
                                                <select id="status" name="status" class="form-select">
                                                    <option onclick="" value="Active" <% if (user.status == 'Active') { %> selected<% } %>>Active</option>
                                                    <option value="Pending" <% if (user.status == 'Pending') { %> selected<% } %>>Pending</option>
                                                    <option value="Inactive" <% if (user.status == 'Inactive') { %> selected<% } %>>Inactive</option>
                                                </select>
                                            </div>
                                        </td>
                                        <!-- <td><%#= user.status %></td> -->
                                        <% if (user.role == 'Admin') { %>
                                            <td class="text-end">
                                                <a href="/dashboard/viewUser/<%= user.id %>" class="btn btn-outline-primary btn-rounded"><i class="fas fa-user"></i></a>
                                            </td>
                                        <% } else { %>
                                            <td class="text-end">
                                                <a href="/dashboard/viewUser/<%= user.id %>" class="btn btn-outline-primary btn-rounded"><i class="fas fa-user"></i></a>
                                                <a href="/dashboard/updateUser/<%= user.id %>" class="btn btn-outline-info btn-rounded"><i class="fas fa-pen"></i></a>
                                                <a href="#" id="deleteBtn" onclick="return confirmDelete('<%= user.id %>')" class="btn btn-outline-danger btn-rounded"><i class="fas fa-trash"></i></a>
                                            </td>
                                        <% } %>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/assets/vendor/jquery/jquery.min.js"></script>
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/datatables/datatables.min.js"></script>
    <script src="/assets/js/initiate-datatables.js"></script>
    <script src="/assets/js/script.js"></script>
    <script>
        // data-bs-toggle="modal" data-bs-target="#confirmDeletionModal"
        function confirmDelete(userId) {            
                let modal = new bootstrap.Modal(document.getElementById("confirmDeletionModal"), {});
                modal.show();
                document.getElementById('yesDelete').onclick = () => {
                    window.location.href = `/dashboard/deleteUser/${userId}`;
                    // or use fetch to do it and show success message 
                    modal.hide();
                }
                return true;
        }
        let status = document.getElementById('status');
        $("#status option").click(function () {
            alert(this.id);
        });
        // status.addEventListener = ("change", (e, userId) => {
        //     console.log(userId);
        //     console.log(e.target.value); 
        //     return true;
        // }); 
    </script>
